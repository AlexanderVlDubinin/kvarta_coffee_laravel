FROM php:8.4-fpm-alpine

# Доустанавливаем Nginx, Node.js, NPM и Supervisor (для управления процессами)
RUN apk add --no-cache \
    bash curl oniguruma-dev libzip-dev libxml2-dev git unzip zip \
    freetype-dev libpng-dev libjpeg-turbo-dev icu-dev libpq-dev \
    nginx nodejs npm

# Установка расширений
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-configure intl \
    && docker-php-ext-install pdo pdo_pgsql mbstring bcmath zip ctype gd intl fileinfo
RUN install-php-extensions sockets
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Копирование всех файлов проекта в контейнер
COPY . .

# Установка зависимостей бэкенда и сборка фронтенд (Vite) для продакшена
RUN composer install --no-dev --optimize-autoloader
RUN npm install && npm run build

# Копирование конфига Nginx в системную директорию
COPY ./docker/nginx/production.conf /etc/nginx/http.d/default.conf

# Скрипт автоматического запуска миграций и серверов
RUN echo '#!/bin/sh' > /usr/local/bin/start.sh && \
    echo 'php artisan config:clear' >> /usr/local/bin/start.sh && \
    echo 'php artisan migrate --force' >> /usr/local/bin/start.sh && \
    echo 'php-fpm -D' >> /usr/local/bin/start.sh && \
    echo 'nginx -g "daemon off;"' >> /usr/local/bin/start.sh && \
    chmod +x /usr/local/bin/start.sh

# Права для Laravel (чтобы у веб-сервера был доступ к кэшу и логам)
RUN chown -R www-data:www-data /var/www

# Для правильной работы Nginx на 80 порту в Alpine контейнер должен стартовать от root, 
# а процессы внутри уже сами переключатся на www-data.
USER root

# Render слушает порт 80 или 10000 по умолчанию
EXPOSE 80

CMD ["/usr/local/bin/start.sh"]